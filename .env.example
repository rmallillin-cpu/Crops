# --- Google OAuth (sign-in) ---
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Set to your deployed URL, e.g. https://psa-cavite-crops.vercel.app
NEXTAUTH_URL=http://localhost:3000

# --- Google Sheets (data store) ---
# Create a Service Account in the same Google Cloud project, generate a JSON key,
# then share your Google Sheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file. Keep the \n escape sequences as-is.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=

# --- Access control ---
# Comma-separated list of admin emails (full dashboard + manage access list).
ADMIN_EMAILS=admin@example.gov.ph

# Sheet tab names (defaults shown — only change if you rename tabs)
SHEET_TAB_ALLOWED_USERS=AllowedUsers
SHEET_TAB_RESPONSES=Responses
SHEET_TAB_SUBMISSIONS=Submissions
